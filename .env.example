# Server-only PostgreSQL settings; do not use VITE_ prefixes for secrets.
PGHOST=psql01.mikr.us
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=verify-full
# Trusted CA certificate supplied/verified by your database provider.
PGSSLROOTCERT=
HOUSE_SYNC_KEY_HASH=
# Local provisioning convenience only: NEVER inject this plaintext key into the API.
HOUSE_SYNC_CONNECTION_KEY=
HOUSE_SYNC_ORIGINS=https://natan203-20203.mikrus.cloud,http://localhost:5173,http://127.0.0.1:5173

# Explicitly opt in to public read/write access for website visitors.
HOUSE_SYNC_PUBLIC_ACCESS=false

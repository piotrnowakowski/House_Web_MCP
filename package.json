  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "dev:interior": "vite --host 127.0.0.1 --port 5187 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test tests/browser-v2.spec.ts --config=playwright.config.ts",
    "test:interior": "playwright test tests/interior.spec.ts --config=playwright.interior.config.ts",
    "assets:interior": "node scripts/build-interior-assets.mjs",
    "assets:thumbnails": "node scripts/render-interior-thumbnails.mjs",
    "test:watch": "vitest",
    "lint": "tsc -b --pretty false"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@react-three/rapier": "^2.2.0",
    "@thatopen/components": "^3.4.8",
    "@thatopen/fragments": "^3.4.7",
    "camera-controls": "^3.1.2",
    "lucide-react": "^1.43.0",
    "manifold-3d": "^3.5.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.182.0",
    "three-mesh-bvh": "^0.9.14",
    "web-ifc": "^0.0.77",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
